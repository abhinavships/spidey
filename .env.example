# Run the driven browser headless (default). Set to 0 to watch a real window
# instead of the preview panel inside the app.
WA_HEADLESS=1

# Drive your own Chrome over CDP instead of a headless browser. Only needed for
# a site where you are already signed in with a browser profile; requires
# ./launch_browser.sh to be running first.
WA_CDP_ATTACH=0

# Chrome DevTools Protocol endpoint used when WA_CDP_ATTACH=1.
WA_CDP=http://localhost:9222

# Seconds between screenshot frames streamed over the websocket.
WA_FRAME_INTERVAL_S=1.0

# Shared token required as a ?token= query param on the /ws/{session_id} websocket.
# Leave unset to disable the check.
WA_DEMO_TOKEN=

# Local OpenAI-compatible model, tried before every hosted provider. Set this
# and the whole demo runs with no API key: `ollama serve` plus e.g.
#   WA_LOCAL_MODEL=llama3.2:3b
WA_LOCAL_MODEL=
WA_LOCAL_BASE=http://localhost:11434/v1
# Local models are slower and often reasoning models; "none" turns thinking off
# so the whole token budget does not go to hidden reasoning.
WA_LOCAL_TIMEOUT=120
WA_LOCAL_REASONING=none

# Claude model used by app/llm.py.
WA_MODEL=claude-sonnet-4-6

# Gemini model used by app/llm.py.
WA_GEMINI_MODEL=gemini-flash-latest

# Timeout in seconds for LLM calls.
WA_LLM_TIMEOUT=6

# Groq model used by app/llm.py.
WA_GROQ_MODEL=llama-3.3-70b-versatile

# API key for Groq. Takes priority over GEMINI_API_KEY and ANTHROPIC_API_KEY when set.
GROQ_API_KEY=

# API key for Google Gemini. Takes priority over ANTHROPIC_API_KEY when set.
GEMINI_API_KEY=

# API key for Anthropic Claude.
ANTHROPIC_API_KEY=


# Directory where workflow specs are stored.
WA_WORKFLOWS_DIR=workflows

# Seconds a grounded answer may take. Raise it when serving a local model.
WA_ANSWER_TIMEOUT=4

# Seconds allowed to classify a chat interruption. A local model needs ~10s;
# timing out here looks to the customer exactly like the agent refusing to answer.
WA_CLASSIFY_TIMEOUT=20

# Evidence chunks retrieved per question before answering.
WA_EVIDENCE_CHUNKS=6

# Chunks of the workflow plan retrieved alongside them, budgeted separately so
# the plan cannot crowd out what the page actually says.
WA_PLAN_CHUNKS=2

# Seconds teaching waits for a human to answer a clarifying question.
WA_TEACH_ANSWER_TIMEOUT=180

# Seconds paced between orchestrator steps.
WA_STEP_PACE_S=1.25
